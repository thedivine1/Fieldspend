type VerifyPaymentResult = 
 record {
   error: opt text;
   success: bool;
 };
type VerifyPaymentRequest = 
 record {
   email: text;
   planType: PlanType;
   razorpay_order_id: text;
   razorpay_payment_id: text;
   razorpay_signature: text;
 };
type UserProfile = 
 record {
   betaExpiryDate: Timestamp;
   companyName: opt text;
   dailyUploadCount: nat;
   isPremium: bool;
   lastUploadDate: Timestamp;
   name: text;
   preferredLanguage: Language;
   userId: UserId;
 };
type UserId = principal;
type Timestamp = int;
type Receipt = 
 record {
   amount: opt float64;
   category: Category;
   createdAt: Timestamp;
   date: Timestamp;
   id: ExpenseId;
   imageData: text;
   notes: opt text;
 };
type PremiumStatusResult = 
 record {
   isPremium: bool;
   planType: opt PlanType;
   premiumExpiryDate: opt Timestamp;
 };
type PlanType = 
 variant {
   annual;
   monthly;
 };
type Language = 
 variant {
   en;
   hi;
   mr;
 };
type ExpenseId = nat;
type CreateOrderResult = 
 record {
   amount: nat;
   currency: text;
   error: opt text;
   orderId: text;
   success: bool;
 };
type CreateOrderRequest = record {planType: PlanType;};
type Category = 
 variant {
   bus;
   cab;
   flight;
   hotel;
   meal;
   other;
   train;
 };
service : {
  addExpense: (receipt: Receipt) -> (ExpenseId);
  createOrder: (req: CreateOrderRequest) -> (CreateOrderResult);
  deleteExpense: (id: ExpenseId) -> ();
  getDailyCount: () -> (nat) query;
  getExpenses: () -> (vec Receipt) query;
  getUserPremiumStatus: (email: text) -> (PremiumStatusResult) query;
  getUserProfile: () -> (opt UserProfile);
  updateExpense: (receipt: Receipt) -> ();
  updateUserProfile: (profile: UserProfile) -> ();
  verifyPayment: (req: VerifyPaymentRequest) -> (VerifyPaymentResult);
}
